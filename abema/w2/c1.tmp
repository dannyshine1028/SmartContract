<!DOCTYPE html>
<html lang="ja">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>エラー | ABEMA</title>
	<meta name="description" content="お探しのページは見つかりませんでした">
	<link rel="icon" href="../assets/img/abema.png?width=32&amp;height=32" />
	<style>
	@font-face {
		font-family: 'Ameba Typo';
		src: url(data:application/x-font-woff;charset=utf-8;base64,) format('woff');
		font-weight: normal;
		font-style: normal;
	}
	</style>
	<style>
		* {
			margin: 0;
			padding: 0;
			color: #e6e6e6;
			box-sizing: border-box;
		}
		body {
			background-color: black;
			font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
			line-height: 1.5;
			background-color: #171717;
		}
		header,main,footer {
			display: block;
		}
		header {
			background-color: #000;
		}
		header span {
			display: block;
			padding: 12px;
		}
		header svg {
			display: block;
		}
		.container {
			display: flex;
			justify-content: center;
			align-items: center;
			width: 100%;
			padding-top: 220px;
			text-align: center;
		}
		.content {
			max-width: 700px;
		}
		.head {
			display: flex;
			align-items: flex-end;
			font-family: 'Ameba Typo', sans-serif;
			padding: 0 0 0 28px;
			font-size: 96px;
		}
		.messege {
			display: block;
			font-weight: 700;
			font-size: 30px;
			margin: 0 0 20px 0;
			letter-spacing: 2px;
		}
		.detail {
			font-size: 24px;
			line-height: 1.7;
			letter-spacing: 1px;
		}
		.abema {
			display: flex;
			justify-content: center;
			align-items: center;
		}
		.flex {
			display: flex;
			justify-content: center;
			align-content: flex-end;
			margin-bottom: 100px;
		}
		footer {
			width: 100%;
			max-width: 700px;
			margin: 170px auto 0;
			padding-bottom: 50px;
		}
		ul {
			list-style: none;
		}
		footer ul {
			display: flex;
			flex-wrap: wrap;
			margin-top: 5px;	
		}
		footer li {
			position: relative;
			margin: 0 10px 0 0;
		}
		footer li a {
			display: block;
			padding: 0 12px 0 0;
			font-size: 15px;
			color: #919191;
			text-decoration: none;
			transition: .3s;
		}
		footer li a:hover {
			opacity: .7;
		}
		footer li:after {
			position: absolute;
			top: 2px;
			right: 0;
			bottom: 4px;
			width: 1px;
			background-color: #919191;
			line-height: 1.0;
			content: '';
		}
		#copy {
			display: block;
			margin: 30px 0 0;
			font-size: 16px;
			letter-spacing: 1px;
			text-align: left;
			color: #919191;
		}
		.link_top {
			margin-top: 130px;
		}
		.link_top a {
			display: inline-block;
			font-weight: 600;
			font-size: 32px;
			color: #fff;
			text-decoration: none;
			transition: .3s;
		}
		.link_top a:hover {
			opacity: .7;
		}
		.abema svg {
			width: 100px;
			height: 130px;
		}
		.com-a-Link svg {
			width: 140px;
			height: 40px;
		}
		@media screen and (max-width: 768px) {
			.container {
				padding-top: 27vw;
			}
			.link_top {
				margin-top: 19vw;
			}
			.content {
				max-width: 100%;
			}
			footer {
				max-width: 100%;
			}
			main {
				padding: 0 30px;
			}
			footer {
				margin-top: 21vw;
				padding: 0 30px 30px;
			}
			.messege {
				margin: 0 0 2.4vw 0;
				font-size: 3.9vw;
			}
			.detail {
				font-size: 3.1vw;
			}
			.link_top a {
				font-size: 4.55vw;
			}
			footer li a {
				font-size: calc(25vw/12);
			}
			#copy {
				font-size: calc(28vw/12);
			}
			.abema,.abema svg {
				width: 13.5vw;
				height: calc(13.5vw * 1.3);
			}
			.head {
				padding-left: 3.8vw;
				font-size: 12.5vw;
			}
			.com-a-Link svg {
				width: 16.4vw;
				min-width: 60px;
				height: calc(16.4vw * 0.285);
				min-height: calc(60px * 0.285);

			}
		}
	</style>
</head>
<body>
	<header>
		<span class="com-a-Link" href="/">
